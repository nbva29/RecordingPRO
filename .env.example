# Docker Compose settings. Copy to .env in the repository root.
DB_NAME=recordingpro
DB_USER=recordingpro_app
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Use a random secret of at least 32 characters.
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_EXPIRE_MINUTES=15

BACKEND_PORT=8000
FRONTEND_PORT=8080
TZ=Asia/Tomsk

# Optional: email password recovery.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
